        <mxCell id="note44" value="OLOR 1 · SRP — OrdenDeTrabajo hace tres cosas: custodia estados, calcula el costo y calcula los tiempos." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="100" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="note45" value="OLOR 2 · OCP — puedeTransicionarA() es un switch: agregar un estado obliga a modificar la clase." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="185" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="note46" value="OLOR 3 · OCP+DIP — Notificacion.enviar() hace switch(canal) y adentro un new del proveedor SMTP." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="270" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="note47" value="OLOR 4 · DIP — la orden hace new Notificacion(): el dominio depende de la infraestructura." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="355" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="note48" value="OLOR 5 · ISP+DIP — ReporteOperativo es de solo lectura pero ve toda la API del dominio." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="440" width="340" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="note49" value="OLOR 6 · SRP — Tecnico es identidad (M0) y capacidad de trabajo (M2) en la misma clase." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5c1a15;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
