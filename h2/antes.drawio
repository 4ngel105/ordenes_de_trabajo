        <mxCell id="e170" value="dispara (new)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;dashed=1;strokeColor=#7a7a7a;" edge="1" parent="1" source="c54" target="c115">
