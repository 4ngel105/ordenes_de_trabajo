        <mxCell id="e172" value="resultado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=10;strokeColor=#3c3c3c;" edge="1" parent="1" source="c115" target="c133">
