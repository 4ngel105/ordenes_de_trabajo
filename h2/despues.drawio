          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e216" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=14;dashed=1;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1" source="c109" target="c98">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note217" value="SRP — La orden adelgazo.&lt;br&gt;costoTotal(), tiempoDeResolucion() y estaVencida() salieron a CalculadoraDeCostos y MetricasDeOrden. Cambiar una tarifa ya no obliga a tocar la clase que custodia los estados." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="90" width="380" height="132" as="geometry"/>
        </mxCell>
        <mxCell id="note218" value="OCP — El switch murio.&lt;br&gt;Una clase por estado detras de «interface» EstadoDeOrden. Agregar un estado es agregar una clase; OrdenDeTrabajo no se modifica. En H3 este mismo refactor se nombra formalmente como patron State." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="242" width="380" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="note219" value="OCP — Regla de asignacion intercambiable.&lt;br&gt;EstrategiaDeAsignacion cumple la promesa del atributo de calidad de mantenibilidad del H1: una politica nueva del jefe de taller es una clase nueva, sin tocar M1." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="400" width="380" height="138" as="geometry"/>
        </mxCell>
        <mxCell id="note220" value="DIP — Se invirtio la dependencia.&lt;br&gt;El dominio ya no hace new de infraestructura: OrdenDeTrabajo depende de «interface» PublicadorDeEventos y ServicioDeNotificacion depende de «interface» CanalDeEnvio. Las flechas apuntan al contrato, no al proveedor concreto." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="558" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="note221" value="ISP — El reporte ve solo lo que necesita.&lt;br&gt;ReporteOperativo depende de ConsultaDeOrdenes, que es de lectura. No conoce guardar(): el invariante &quot;M6 es de solo lectura&quot; pasa a estar garantizado por el tipo y no por disciplina del programador." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="728" width="380" height="144" as="geometry"/>
        </mxCell>
        <mxCell id="note222" value="LSP — La sustituibilidad que hay que respetar.&lt;br&gt;Toda implementacion de CanalDeEnvio devuelve ResultadoEnvio y nunca lanza una excepcion propia, y todo EstadoDeOrden responde puedeTransicionarA() sin efectos secundarios. Si una implementacion rompe eso, el polimorfismo de arriba deja de ser seguro." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="892" width="380" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="note223" value="ALCANCE DEL DIAGRAMA&lt;br&gt;Cliente, Equipo, Repuesto, UsoDeRepuesto y Prioridad no cambian con este refactor y se omiten para no ensuciar el foco. Estan completos en el diagrama ANTES." style="shape=note;size=16;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;spacingRight=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2200" y="1062" width="380" height="128" as="geometry"/>
        </mxCell>
        <mxCell id="leyenda" value="LEYENDA&lt;br&gt;&lt;br&gt;Verde = «interface» (contrato)&lt;br&gt;Amarillo = clase nueva o extraida en este refactor&lt;br&gt;Azul = clase del dominio que ya existia en el H1&lt;br&gt;Flecha punteada con triangulo = implementa&lt;br&gt;Flecha verde punteada = depende de un contrato, no de una clase concreta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="1120" width="640" height="140" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
