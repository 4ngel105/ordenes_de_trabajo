        <mxCell id="e76" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;endSize=12;dashed=1;strokeColor=#2e7d32;strokeWidth=1.5;" edge="1" parent="1" source="c28" target="c26">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note77" value="SRP — la orden ya no calcula costos ni tiempos: eso salio a dos clases propias." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="100" width="330" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="note78" value="OCP — una clase por estado detras de la interfaz: agregar un estado no modifica la orden." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="190" width="330" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="note79" value="OCP — la politica de asignacion es intercambiable sin tocar el servicio que asigna." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="280" width="330" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="note80" value="DIP — el dominio ya no hace new: depende de PublicadorDeEventos, y el servicio de CanalDeEnvio." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="370" width="330" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="note81" value="ISP — el reporte recibe el contrato de lectura: no conoce guardar()." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="470" width="330" height="72" as="geometry"/>
        </mxCell>
        <mxCell id="note82" value="LSP — toda implementacion respeta el contrato: sin excepciones propias ni efectos raros." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1e3d1a;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="2060" y="560" width="330" height="82" as="geometry"/>
        </mxCell>
        <mxCell id="leyenda" value="&lt;b&gt;LEYENDA&lt;/b&gt;&lt;br&gt;Verde = interfaz (contrato) · Amarillo = clase nueva del refactor&lt;br&gt;Azul = clase que ya existia en el H1 · Violeta = enumeracion&lt;br&gt;Flecha punteada con triangulo = implementa&lt;br&gt;Flecha verde = depende de un contrato, no de una clase concreta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9e9e9e;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="570" width="480" height="110" as="geometry"/>
        </mxCell>
      </root>
